# Domain (without https://, slash, or port). Create an A DNS record first.
CHESS_DOMAIN=chess.example.org
# Generate a permanent secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ random characters. NEVER check this file into git.
CHESS_SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
# Consistent local SQLite snapshots run daily. Backup failure marks the backups
# service unhealthy and retries in 5 minutes. Monitor Docker health externally.
CHESS_BACKUP_INTERVAL=86400
# Optional encrypted off-server repository; see HOSTING.md. Credentials/password
# live in ignored ./secrets files, not this file or Git.
# RESTIC_REPOSITORY=s3:https://s3.example.org/club-backups/liga

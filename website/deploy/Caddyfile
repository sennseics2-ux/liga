# Point the A/AAAA DNS records of CHESS_DOMAIN at this server.
# Caddy requests/renews certificates and proxies HTTP traffic to the app.
{$CHESS_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 8MiB
    }
    reverse_proxy web:8000
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    log {
        output stdout
        format console
    }
}

# Static club landing page; the League remains on CHESS_DOMAIN above.
www.sx-aac.com {
    root * /srv/landing
    encode zstd gzip
    file_server
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

sx-aac.com {
    redir https://www.sx-aac.com{uri} permanent
}
